      "parameters": {
        "jsCode": "// Get all items from the previous node\nconst items = $input.all();\n\n// Assuming your HTTP Request node structure, reach into the 'value' array\nconst files = items[0].json.value;\n\n// Sort by date to find the most recent\nfiles.sort((a, b) => new Date(b.lastModifiedDateTime) - new Date(a.lastModifiedDateTime));\n\n// Return ONLY the newest file as the root object\nreturn [{\n  json: files[0]\n}];"
