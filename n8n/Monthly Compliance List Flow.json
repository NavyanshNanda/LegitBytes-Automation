    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n\n    const date = item.json.WorkDate\n        ? item.json.WorkDate.split('T')[0]\n        : null;\n\n    return {\n        json: {\n            ...item.json,\n            WorkDateOnly: date\n        }\n    };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
