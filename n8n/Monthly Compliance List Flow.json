      ],
      "id": "263e5d7d-1ecc-49ff-b6aa-a8175839cfe9",
      "name": "Normalize Compliance Dates"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  return {\n    json: {\n      ...item.json.fields,\n      WorkDateOnly: item.json.fields.WorkDate\n        ? item.json.fields.WorkDate.split('T')[0]\n        : null\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1648,
        160
      ],
      "id": "75b738c7-7a42-47e5-a325-268c5b1fd7cd",
      "name": "Flatten Compliance"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// ================================\n// SEPARATE DATASETS\n// ================================\n\nconst muster = items.filter(\n    i => i.json.Name !== undefined &&\n         i.json[\"Employee No\"] !== undefined\n);\n\nconst compliance = items.filter(\n    i => i.json.EmployeeID !== undefined &&\n         i.json.WorkDateOnly !== undefined\n);\n\nconst employeeList = items.filter(\n    i => i.json.fields?.EmployeeID !== undefined\n);\n\n// ================================\n// CREATE EMPLOYEE MASTER RECORDS\n// (Source of Truth = Employee List)\n// ================================\n\nconst employees = {};\n\nfor (const item of employeeList) {\n\n    const employee = item.json.fields;\n\n    const employeeId = employee.EmployeeID;\n\n    employees[employeeId] = {\n        EmployeeID: employeeId,\n        EmployeeName: employee.Title || \"\",\n        EmployeeEmail: employee.EmployeeEmail || \"\",\n        Shift: employee.Shift || \"\",\n        Month: \"\",\n\n        ExpectedWorkingDays: 0,\n        MissedSODDays: 0,\n        MissedEODDays: 0,\n\n        TotalSODTasks: 0,\n        TotalEODTasks: 0,\n        TotalDelayedTasks: 0,\n\n        WorkingDates: new Set(),\n        ComplianceDates: {}\n    };\n}\n\n// ================================\n// PROCESS ATTENDANCE MUSTER\n// ================================\n\nfor (const item of muster) {\n\n    const employeeId = item.json[\"Employee No\"];\n    const attendanceDate = item.json[\"Attendance Date\"];\n\n    if (!employees[employeeId]) {\n        continue;\n    }\n\n    if (item.json.IsWorkingDay === true) {\n\n        employees[employeeId].ExpectedWorkingDays++;\n\n        employees[employeeId].WorkingDates.add(attendanceDate);\n    }\n}\n\n// ================================\n// PROCESS COMPLIANCE\n// ================================\n\nfor (const item of compliance) {\n\n    const employeeId = item.json.EmployeeID;\n    const date = item.json.WorkDateOnly;\n\n    if (!employees[employeeId]) {\n        continue;\n    }\n\n    // Month for report\n    if (!employees[employeeId].Month && date) {\n        employees[employeeId].Month = date.substring(0, 7);\n    }\n\n    employees[employeeId].TotalSODTasks += Number(item.json.SODTaskCount || 0);\n\n    employees[employeeId].TotalEODTasks += Number(item.json.EODTaskCount || 0);\n\n    employees[employeeId].TotalDelayedTasks += Number(item.json.DelayedTaskCount || 0);\n\n    employees[employeeId].ComplianceDates[date] = {\n        SOD: item.json.SODSubmitted === true,\n        EOD: item.json.EODSubmitted === true\n    };\n}\n\n// ================================\n// CALCULATE MISSED DAYS\n// ================================\n\nfor (const employee of Object.values(employees)) {\n\n    for (const workDate of employee.WorkingDates) {\n\n        const complianceRecord =\n            employee.ComplianceDates[workDate];\n\n        if (!complianceRecord || complianceRecord.SOD !== true) {\n            employee.MissedSODDays++;\n        }\n\n        if (!complianceRecord || complianceRecord.EOD !== true) {\n            employee.MissedEODDays++;\n        }\n    }\n\n    delete employee.WorkingDates;\n    delete employee.ComplianceDates;\n}\n\n// ================================\n// OUTPUT\n// ================================\n\nreturn Object.values(employees).map(emp => ({\n    json: {\n        EmployeeName: emp.EmployeeName,\n        EmployeeEmail: emp.EmployeeEmail,\n        EmployeeID: emp.EmployeeID,\n        Month: emp.Month,\n        Shift: emp.Shift,\n\n        ExpectedWorkingDays: emp.ExpectedWorkingDays,\n        MissedSODDays: emp.MissedSODDays,\n        MissedEODDays: emp.MissedEODDays,\n\n        TotalSODTasks: emp.TotalSODTasks,\n        TotalEODTasks: emp.TotalEODTasks,\n        TotalDelayedTasks: emp.TotalDelayedTasks\n    }\n}));"
      },
