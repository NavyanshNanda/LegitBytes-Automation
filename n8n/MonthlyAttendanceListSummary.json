    {
      "parameters": {
        "jsCode": "// Converts \"HH : MM\" into minutes\nfunction timeToMinutes(timeString) {\n    if (!timeString) return 0;\n\n    const parts = timeString.split(':').map(x => parseInt(x.trim()) || 0);\n\n    return (parts[0] * 60) + parts[1];\n}\n// Get cleaned rows from the previous Mapping Node \nconst rows = $input.all(); \n\n// Tracking object \nconst employees = {}; \n\n// --- DYNAMIC MONTH CALCULATION ---\n// Gets the current date, goes back 1 month, and formats it (e.g., \"June 2026\")\nconst reportDateObj = new Date();\nreportDateObj.setMonth(reportDateObj.getMonth() - 1);\nconst dynamicMonth = reportDateObj.toLocaleString('default', { month: 'long', year: 'numeric' });\n// ---------------------------------\n\n// 1. Process rows into stats \nfor (const row of rows) { \n    const data = row.json; \n    const name = data.Name; \n    if (!name) continue; \n    if (!employees[name]) { \n        employees[name] = {\n    absences: 0,\n    leaves: 0,\n    wfh: 0,\n    late: 0,\n    excessMinutes: 0,\n    workMinutes: 0\n};\n    } \n\n    // LATE logic \n    const totalLateMinutes = (parseInt(data[\"Late In Hrs\"].split(':')[0] || 0) * 60) + parseInt(data[\"Late In Hrs\"].split(':')[1] || 0); \n    if (totalLateMinutes > 15) employees[name].late++; \n\nemployees[name].excessMinutes += timeToMinutes(data[\"Excess Hours\"]);\nemployees[name].workMinutes += timeToMinutes(data[\"Total Work Hours\"]);\n  \n    // STATUS logic \n    const s1 = (data[\"Session1 Status\"] || \"\").trim(); \n    const s2 = (data[\"Session2 Status\"] || \"\").trim(); \n    if (s1 === \"A\" && s2 === \"A\") employees[name].absences++; \n    if ([\"EL\", \"SL\", \"CL\"].includes(s1) && s1 === s2) employees[name].leaves++; \n    if (s1 === \"WFH\" && s2 === \"WFH\") employees[name].wfh++; \n} \n\nfunction minutesToHHMM(totalMinutes) {\n    const hrs = Math.floor(totalMinutes / 60);\n    const mins = totalMinutes % 60;\n\n    return `${hrs}:${mins.toString().padStart(2,'0')}`;\n}\n\n// 2. Format as an array of objects for the SharePoint Node \nconst sharepointItems = Object.entries(employees).map(([name, stats]) => ({ \n    json: {\n    Month: dynamicMonth,\n    EmployeeName: name,\n    LateCount: stats.late,\n    AbsenceDays: stats.absences,\n    WFHCount: stats.wfh,\n    TotalLeaveCount: stats.leaves,\n\n    MonthlyWorkHours: minutesToHHMM(stats.workMinutes),\n    MonthlyExcessHours: minutesToHHMM(stats.excessMinutes),\n\n    ReportDate: new Date().toISOString()\n}\n})); \n\nreturn sharepointItems;\n"
      },
