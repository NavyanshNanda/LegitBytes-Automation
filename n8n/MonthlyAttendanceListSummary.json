    {
      "parameters": {
        "jsCode": "// Get all raw rows from the Spreadsheet node\nconst rows = $input.all();\n\n// 1. Skip the first 2 rows (index 0 and 1)\nconst dataRows = rows.slice(3);\n\n// 2. Map the data to your specific schema\nreturn dataRows.map(row => {\n  const json = row.json;\n  return {\n    json: {\n      \"SNO\": json[\"LegitBytes Information Technology Services LLP\"],\n      \"Name\": json[\"__EMPTY\"],\n      \"Employee No\": json[\"__EMPTY_1\"],\n      \"Date of Joining\": json[\"__EMPTY_2\"],\n      \"Manager No\": json[\"__EMPTY_3\"],\n      \"Manager Name\": json[\"__EMPTY_4\"],\n      \"Attendance Date\": json[\"__EMPTY_5\"],\n      \"Day\": json[\"__EMPTY_6\"],\n      \"Session1 Status\": json[\"__EMPTY_7\"],\n      \"Session2 Status\": json[\"__EMPTY_8\"],\n      \"In Time\": json[\"__EMPTY_9\"],\n      \"Out Time\": json[\"__EMPTY_10\"],\n      \"Shift Name\": json[\"__EMPTY_11\"],\n      \"Shift In Time\": json[\"__EMPTY_12\"],\n      \"Shift Out Time\": json[\"__EMPTY_13\"],\n      \"Late In Hrs\": json[\"__EMPTY_14\"],\n      \"Early Out Hrs\": json[\"__EMPTY_15\"],\n      \"Work Hours\": json[\"__EMPTY_16\"],\n      \"Excess Hours\": json[\"__EMPTY_17\"],\n      \"Total Work Hours\": json[\"__EMPTY_18\"]\n    }\n  };\n});"
      },
